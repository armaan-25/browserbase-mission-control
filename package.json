{
  "name": "browserbase-mission-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mission Control for Browserbase Agents: stuck agents reach a person, safely",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "inbox": "node --env-file-if-exists=.env inbox/serve.ts",
    "inbox:demo": "node inbox/demo.ts",
    "inbox:remember": "node inbox/demo-remember.ts",
    "login:add": "node inbox/credentials.ts",
    "inbox:loom": "node inbox/demo-loom.ts"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
