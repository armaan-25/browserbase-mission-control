{
  "name": "browser-write-lease",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An inbox for Browserbase Agents runs that pause for a person, where a person's help carries over to later runs",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "inbox": "node --env-file-if-exists=.env inbox/serve.ts",
    "inbox:demo": "node inbox/demo.ts",
    "inbox:remember": "node inbox/demo-remember.ts"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
